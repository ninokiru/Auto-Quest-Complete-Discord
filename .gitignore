# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
/build/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri
/target
src-tauri/target
src-runner/target
src-cdp-launcher/target
src-tauri/binaries/
*.pdb

# Platform-specific runner executables are generated by scripts/build-runner.js.
src-tauri/data/stagecraft*

# Generated schemas
src-tauri/gen/schemas/*
!src-tauri/gen/schemas/.gitkeep

# Cargo lock files (we want to commit these for reproducible builds)
# Cargo.lock

!src-tauri/tauri.conf.json
!src-tauri/capabilities/*.json
!package.json
*.har
auto-quest-complete-discord-v*.zip
*.code-workspace
*.exe
*.msi
*.txt
# public/version.txt is the canonical release version and public/version-desc.txt
# is the GitHub release body; both must stay tracked despite the *.txt rule.
!public/version.txt
!public/version-desc.txt
/private-scripts/*

# i18n validation/audit reports
reports/

.workbuddy/
.codebuddy/
deliverables/
